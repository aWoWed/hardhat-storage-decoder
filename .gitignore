# Secrets. Git does not expand braces, and `deployments/**/contracts` would ignore the source
# mocks in deployments/contracts/, so the deployment workspaces are listed one by one.
.env
.env.*
!.env.example
*.keystore
*.pem
*.key
.[eE][nN][vV]
.npmrc
.envrc
key.txt
secrets.json
keystore.json
.tools/

