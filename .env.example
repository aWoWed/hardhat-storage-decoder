# Names only. Copy to .env (ignored) and fill in locally; never commit a value.
# No key or mnemonic ever belongs in .env: the deployer key and SEPOLIA_RPC_URL live only in the
# Hardhat 3 keystore, and the seed script refuses to run if the key is set in the environment.

# Optional endpoints for the read-back. Unset, it uses keyless public ones. May hold a token, so
# they stay out of the repo.
READBACK_RPC_URL=
READBACK_SECOND_RPC_URL=

# Archive endpoint for the owner's mainnet check at gate G5. May hold a token, so it stays out of
# the repo. Without it the check reports "could not check".
MAINNET_ARCHIVE_RPC_URL=
