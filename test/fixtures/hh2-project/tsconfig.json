{
  // `node16` rather than the classic `node` resolution: `hardhat-storage-decoder` is
  // exports-map-only (`./hardhat2` is not a real directory), so classic resolution cannot
  // find it and the augmentation gate would fail for the wrong reason.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "mocha", "chai"]
  },
  "include": ["hardhat.config.ts", "test/**/*.ts"]
}
